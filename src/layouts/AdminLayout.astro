---
import '../styles/global.css';
import '../styles/admin.css';
import { getDb } from '../lib/db';
import { flashText } from '../lib/admin';

interface Props {
  title: string;
  active?: string;
  bare?: boolean;
}

const { title, active = '', bare = false } = Astro.props;
const { theme, currency, admin } = Astro.locals;
const flash = flashText(Astro.url);
const path = Astro.url.pathname;

let newMessages = 0;
if (admin) {
  try {
    const db = await getDb();
    const row = await db.prepare("SELECT COUNT(*) AS n FROM messages WHERE status = 'new'").first<{ n: number }>();
    newMessages = row?.n ?? 0;
  } catch {
    newMessages = 0;
  }
}

const nav = [
  { key: 'dashboard', href: '/admin', label: 'Dashboard' },
  { key: 'projects', href: '/admin/projects', label: 'Projects' },
  { key: 'offers', href: '/admin/offers', label: 'Offers' },
  { key: 'services', href: '/admin/services', label: 'Services and prices' },
  { key: 'pages', href: '/admin/pages', label: 'Pages' },
  { key: 'media', href: '/admin/media', label: 'Media' },
  { key: 'messages', href: '/admin/messages', label: 'Messages' },
  { key: 'settings', href: '/admin/settings', label: 'Settings' },
];
---

<!doctype html>
<html lang="en" data-theme={theme ?? undefined} data-currency={currency}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} | Site admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/bricolage-grotesque.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="admin-body">
    <a class="skip-link" href="#main">Skip to content</a>
    {
      bare ? (
        <main id="main" tabindex="-1">
          <slot />
        </main>
      ) : (
        <div class="admin-shell">
          <aside class="admin-side">
            <div class="admin-brand">
              <strong>Sahisnu Acharya</strong>
              <span>Site admin</span>
            </div>
            <nav class="admin-nav" aria-label="Admin">
              <ul>
                {nav.map((item) => (
                  <li>
                    <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>
                      <span>{item.label}</span>
                      {item.key === 'messages' && newMessages > 0 && (
                        <span class="badge">
                          {newMessages}
                          <span class="sr-only"> new</span>
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
            <div class="admin-side-foot">
              <a class="text-link" href="/" target="_blank" rel="noopener">
                View live site<span class="sr-only"> (opens in a new tab)</span>
              </a>
              <form method="post" action="/api/prefs" data-theme-form>
                <input type="hidden" name="back" value={path} />
                <button class="link-btn" type="submit" name="toggle" value="theme">
                  Switch light or dark
                </button>
              </form>
              <form method="post" action="/api/auth/logout">
                <button class="link-btn" type="submit">
                  Sign out
                </button>
              </form>
            </div>
          </aside>
          <main id="main" class="admin-main" tabindex="-1">
            {flash && (
              <p class="notice is-success" role="status" style="margin-bottom: 20px">
                {flash}
              </p>
            )}
            <slot />
          </main>
        </div>
      )
    }

    <dialog class="picker" id="media-picker" aria-labelledby="picker-title">
      <div class="picker-head">
        <h2 id="picker-title">Choose an image</h2>
        <button class="btn btn-ghost btn-xs" type="button" data-picker-close>Close</button>
      </div>
      <div class="picker-body">
        <p class="hint" data-picker-status>Loading your images...</p>
        <ul class="media-grid" data-picker-grid></ul>
      </div>
    </dialog>

    <script>
      import '../scripts/site';
      import '../scripts/admin';
    </script>
  </body>
</html>
