---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminEmail, createSession, googleConfig, requestLoginCode, verifyLoginCode } from '../../lib/auth';
import { text } from '../../lib/admin';

const errors: Record<string, string> = {
  google_not_set: 'Google sign-in is not set up yet. Use the email code below.',
  google_failed: 'Google sign-in did not finish. Please try again.',
  not_allowed: 'That Google account cannot open this admin panel.',
};

let step: 'start' | 'code' = 'start';
let email = '';
let message = '';
let isError = false;

const urlError = Astro.url.searchParams.get('error');
if (urlError && errors[urlError]) {
  message = errors[urlError];
  isError = true;
}
if (Astro.url.searchParams.get('msg') === 'signed_out') message = 'You are signed out.';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = text(form, '_action', 20);
  email = text(form, 'email', 200);

  if (action === 'request') {
    const result = await requestLoginCode(email);
    step = 'code';
    isError = false;
    if (result === 'throttled') {
      message = 'A code was sent recently. Please wait a minute, or use the last code you got.';
    } else if (result === 'locked') {
      message = 'Too many wrong codes. Please wait 15 minutes and try again.';
      isError = true;
      step = 'start';
    } else if (result === 'failed') {
      message = 'The email could not be sent right now. Please try again in a minute.';
      isError = true;
      step = 'start';
    } else {
      // Same message for the right and wrong address, so nobody can guess the admin email.
      message = 'If that is the admin address, a 6-digit code is on its way. Check your inbox and spam.';
    }
  }

  if (action === 'verify') {
    const result = await verifyLoginCode(email, text(form, 'code', 20));
    if (result === 'ok') {
      await createSession(Astro.cookies, Astro.url, adminEmail());
      return Astro.redirect('/admin', 303);
    }
    step = result === 'locked' ? 'start' : 'code';
    isError = true;
    message =
      result === 'locked'
        ? 'Too many wrong codes. Please wait 15 minutes and try again.'
        : result === 'expired'
          ? 'That code has expired. Please ask for a new one.'
          : 'That code is not right. Please check it and try again.';
  }
}

const googleReady = googleConfig(Astro.url) !== null;
---

<AdminLayout title="Sign in" bare>
  <div class="login-wrap">
    <div class="card login-card">
      <h1>Sign in</h1>
      <p class="hint" style="margin-bottom: 24px">Admin panel for sahisnuacharya.com.np</p>

      {message && <p class:list={['notice', isError ? 'is-error' : 'is-success']} role={isError ? 'alert' : 'status'} style="margin-bottom: 20px">{message}</p>}

      {
        step === 'start' && (
          <>
            {googleReady && (
              <>
                <a class="btn google-btn" href="/api/auth/google">
                  <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true">
                    <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z" />
                    <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
                    <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2c-2 1.5-4.5 2.4-7.2 2.4-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z" />
                    <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z" />
                  </svg>
                  Sign in with Google
                </a>
                <p class="or">or get a code by email</p>
              </>
            )}
            <form method="post" class="form-grid">
              <input type="hidden" name="_action" value="request" />
              <div class="field">
                <label for="email">Admin email</label>
                <input id="email" name="email" type="email" autocomplete="email" required value={email} />
              </div>
              <button class="btn btn-primary" type="submit">Email me a sign-in code</button>
            </form>
          </>
        )
      }

      {
        step === 'code' && (
          <form method="post" class="form-grid">
            <input type="hidden" name="_action" value="verify" />
            <input type="hidden" name="email" value={email} />
            <div class="field">
              <label for="code">6-digit code</label>
              <input id="code" class="code-input" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required autofocus />
              <p class="hint">The code works for 10 minutes. After 5 wrong tries, sign-in pauses for 15 minutes.</p>
            </div>
            <button class="btn btn-primary" type="submit">Sign in</button>
            <a class="text-link" href="/admin/login">Start again</a>
          </form>
        )
      }
    </div>
  </div>
</AdminLayout>
